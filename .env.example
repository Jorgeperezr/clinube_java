# Las MISMAS variables que usa Django, para que el .env de clinube sirva
# aquí sin tocarlo y los dos servidores puedan arrancar contra la misma
# base. Copiar a .env y ajustar.

# La clave con la que se firman los JWT. En desarrollo puede quedarse así;
# con DJANGO_ENTORNO=produccion el servidor NO arranca con este valor.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-never-use-in-production
DJANGO_DEBUG=True
DJANGO_ENTORNO=desarrollo
DJANGO_TIME_ZONE=America/Guayaquil
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Mailpit (docker compose): el correo no sale a internet, se ve en
# http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# El panel en desarrollo
CORS_ALLOWED_ORIGINS=http://localhost:3000
PANEL_URL=http://localhost:3000
