#!/usr/bin/env bash
# Levanta Django (8010) y Kotlin (8000) contra sus copias de la misma base
# y compara las respuestas de los dos. Al terminar, los para.
set -uo pipefail
raiz="$(cd "$(dirname "$0")/.." && pwd)"
clinube="${CLINUBE:-$raiz/../clinube}"
# La base de referencia NO se toca: cada servidor trabaja con su propia
# copia. Algunas peticiones cambian el estado (aceptar las condiciones), y
# si Django trabajara sobre la referencia, la dejaría distinta para la
# siguiente captura.
base_ref="${BASE_REF:-clinube_ref}"
base_django="${BASE_DJANGO:-clinube_cmp_django}"
base_kotlin="${BASE_KOTLIN:-clinube_cmp_kotlin}"

[ -x "$clinube/.venv/bin/python" ] || { echo "clinube no tiene su .venv en $clinube" >&2; exit 1; }
if [ -x "$raiz/gradlew" ]; then GRADLE=./gradlew
elif command -v gradle >/dev/null 2>&1; then GRADLE=gradle
else echo "No hay ni ./gradlew ni gradle. Mira: ./scripts/comprobar-entorno.sh" >&2; exit 1
fi

pids=()
registros="$(mktemp -d)"
# `bootRun` arranca la aplicación en otra JVM, hija del demonio de Gradle:
# matar el proceso lanzado no basta. Se para también lo que siga escuchando
# en los dos puertos, para no dejar un servidor huérfano ocupando el 8000.
limpiar() {
  for p in "${pids[@]:-}"; do kill "$p" 2>/dev/null; done
  for puerto in 8000 8010; do
    lsof -ti "tcp:$puerto" -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null
  done
}
trap limpiar EXIT

esperar() {
  for _ in $(seq 1 90); do
    curl -s -o /dev/null -m 2 "$1/api/v1/health/" && return 0
    sleep 1
  done
  echo "No arrancó: $1" >&2; return 1
}

echo "→ Dos copias de $base_ref: $base_django y $base_kotlin"
for copia in "$base_django" "$base_kotlin"; do
  psql -h localhost -d postgres -qc "DROP DATABASE IF EXISTS $copia"
  psql -h localhost -d postgres -qc "CREATE DATABASE $copia WITH TEMPLATE $base_ref OWNER clinica"
done

echo "→ Django en el 8010"
( cd "$clinube/django-api" && \
  POSTGRES_HOST=localhost POSTGRES_DB="$base_django" POSTGRES_USER=clinica POSTGRES_PASSWORD=clinica \
  DJANGO_DEBUG=True DJANGO_LOG_LEVEL=WARNING \
  exec "$clinube/.venv/bin/python" manage.py runserver 127.0.0.1:8010 --noreload >"$registros/django.log" 2>&1 ) &
pids+=($!)

echo "→ Kotlin en el 8000"
( cd "$raiz" && POSTGRES_HOST=localhost POSTGRES_DB="$base_kotlin" POSTGRES_USER=clinica \
  POSTGRES_PASSWORD=clinica exec "$GRADLE" --quiet :backend:bootRun >"$registros/kotlin.log" 2>&1 ) &
pids+=($!)

esperar http://127.0.0.1:8010 || { tail -20 "$registros/django.log"; exit 1; }
esperar http://127.0.0.1:8000 || { tail -30 "$registros/kotlin.log"; exit 1; }

echo "  (registros de los dos servidores en $registros)"
echo
python3 "$raiz/scripts/comparar-contrato.py" \
  --markdown "$raiz/docs/contrato/INFORME-COMPARADOR.md" "$@"
